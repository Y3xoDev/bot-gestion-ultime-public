# Token du compte BOT créé dans le portail développeur Discord.
BOT_TOKEN=ton_token_de_bot

# Identifiant du serveur sur lequel enregistrer les commandes.
GUILD_ID=identifiant_du_serveur

# Activité facultative affichée sous le nom du bot.
BOT_ACTIVITY=protège le serveur
BOT_PREFIX=+
BOT_PRIVILEGED_INTENTS=true

# Owners supplémentaires facultatifs, séparés par des virgules. L'owner de l'application est toujours reconnu.
BOT_OWNER_IDS=

# Compteur de membres humains en ligne : activer Presence Intent dans le portail avant de mettre true.
BOT_PRESENCE_INTENT=false
